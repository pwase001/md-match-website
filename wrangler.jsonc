{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "morning-art-6f48",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-06",
  "observability": {
    "enabled": true
  },
    "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // Compliance reminders: every Monday at 13:00 and 14:00 UTC. One of the two is
  // always 9am in New York across daylight saving; the handler checks the Eastern
  // clock, ignores the other, and only proceeds on the 4th Monday of the month.
  //
  // The day is named rather than numbered: Cloudflare's parser treats 1 as Sunday,
  // so the Unix-style "* * * * 1" for Monday silently scheduled these a day early.
  // The dashboard's Cron Triggers panel should read "on Monday".
  "triggers": {
    // 12:00 UTC is 8am Eastern in summer and 7am in winter, so an invoice dated
    // today goes out on the morning of that date either way.
    "crons": ["0 12 * * *", "0 13 * * MON", "0 14 * * MON"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "collabmd-db",
      "database_id": "739db1a9-3aef-4230-bb0e-274d78fe59ab"
    }
  ]
}
