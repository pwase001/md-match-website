{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "morning-art-6f48",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-06",
  "observability": {
    "enabled": true
  },
    "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // Scheduled compliance reminders are held until the first run has been sent by
  // hand from /admin-compliance-reminders and the pairings confirmed. Restoring
  // the two entries below turns the schedule on: every Monday at 13:00 and 14:00
  // UTC, one of which is always 9am in New York across daylight saving, with the
  // handler ignoring the other and only proceeding on the 4th Monday.
  "triggers": {
    "crons": []
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "collabmd-db",
      "database_id": "739db1a9-3aef-4230-bb0e-274d78fe59ab"
    }
  ]
}
