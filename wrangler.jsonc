{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "morning-art-6f48",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-06",
  "observability": {
    "enabled": true
  },
    "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // Every Monday at 13:00 and 14:00 UTC. One of the two is 9am in New York on
  // either side of daylight saving; the handler checks the Eastern clock and
  // ignores the other, and only proceeds on the 4th Monday of the month.
  "triggers": {
    "crons": ["0 13 * * 1", "0 14 * * 1"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "collabmd-db",
      "database_id": "739db1a9-3aef-4230-bb0e-274d78fe59ab"
    }
  ]
}
